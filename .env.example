# ==========================================
# DriveGuard AI - Environment Configuration
# ==========================================

# Twilio SMS Alert Credentials (Optional)
# If left blank, DriveGuard AI operates in Simulated SMS Mode
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Registered Emergency Contact
EMERGENCY_CONTACT_PHONE=+15559876543
EMERGENCY_CONTACT_NAME=Fleet Safety Manager

# Alert Controls
ENABLE_SMS_ALERTS=false
DEFAULT_AUDIO_VOLUME=0.8

# Camera Default
DEFAULT_CAMERA_INDEX=0
